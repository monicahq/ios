      },
      "extractionState" : "manual"
    },
    "auth_error_cancelled" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign-in was cancelled. Log in again when you're ready."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion a été annulée. Reconnectez-vous quand vous voulez."
