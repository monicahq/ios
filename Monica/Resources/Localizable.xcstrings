    },
    "auth_error_certificate" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This instance's security certificate isn't valid. Ask its administrator to fix it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le certificat de sécurité de cette instance n'est pas valide. Demandez à son administrateur de le corriger."
          }
        }
      },
      "extractionState" : "manual"
    },
    "auth_error_denied" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You did not allow access. Log in again to allow it."
          }
