    },
    "auth_error_app_too_old" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This instance needs a newer version of the app. Update it from the App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette instance demande une version plus récente de l'app. Mettez-la à jour depuis l'App Store."
