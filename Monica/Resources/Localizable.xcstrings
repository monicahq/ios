      "comment" : "Explanation under the address field of the instance sheet.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The address of the Monica server the app connects to. Keep the default to use the hosted service, or enter the address of your own instance."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'adresse du serveur Monica auquel l'app se connecte. Laissez la valeur par défaut pour utiliser le service hébergé, ou saisissez celle de votre propre instance."
          }
        }
      }
    },
